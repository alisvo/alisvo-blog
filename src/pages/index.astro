---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechBadge from '../components/TechBadge.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recentPosts = sortedPosts.slice(0, 3);

const dbaCompetencies = [
  { name: 'PostgreSQL', category: 'database', level: 'CORE' },
  { name: 'Oracle Database', category: 'database', level: 'PRODUCTION' },
  { name: 'Azure & AWS', category: 'skill', level: 'DATA ENGINEER' },
  { name: 'Microsoft SQL Server', category: 'database', level: 'ENTERPRISE' },
  { name: 'MySQL / MariaDB', category: 'database', level: 'CLUSTERED' },
  { name: 'Performance Tuning', category: 'skill', level: 'ADVANCED' },
  { name: 'High Availability (HA)', category: 'skill', level: 'PATRONI / PACEMAKER' },
  { name: 'Backup & Disaster Recovery', category: 'skill', level: 'RPO=0 / PITR' },
  { name: 'Linux / Kernel I/O', category: 'os', level: 'RHEL / UBUNTU' },
  { name: 'Python for DevOps', category: 'skill', level: 'AUTOMATION' },
  { name: 'Redis / In-Memory Cache', category: 'database', level: 'CACHING' },
  { name: 'Query Optimization', category: 'skill', level: 'EXPLAIN ANALYZE' },
];
---

<BaseLayout
  title="Ali Sağırvelioğulları | Senior Database Administrator (DBA)"
  description="Senior Database Administrator (DBA) & AWS Certified Data Engineer. PostgreSQL, Oracle, MSSQL, bulut veritabanı altyapıları, yüksek erişilebilirlik ve felaket kurtarma uzmanı."
>
  <!-- Hero Section -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-14 sm:pt-24 sm:pb-20">
    <div class="space-y-6">
      
      <!-- Availability Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-emerald-500/10 dark:bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-400">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Senior Database Administrator (DBA) • AWS Certified • alisvo.dev</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15]">
        Veri Bütünlüğü, <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 via-teal-500 to-cyan-500 dark:from-emerald-400 dark:via-teal-300 dark:to-cyan-400">
          Sıfır Kesinti & Yüksek Performans.
        </span>
      </h1>

      <!-- Bio / Tagline -->
      <p class="max-w-2xl text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed">
        Merhaba, ben <strong class="font-semibold text-slate-900 dark:text-white">Ali Sağırvelioğulları</strong>. 
        Kurumsal on-premise ve bulut (AWS, Azure) mimarilerinde yüksek işlem hacimli (OLTP & OLAP) veritabanı tasarımı, 
        sorgu optimizasyonu, 7/24 yüksek erişilebilirlik (HA) ve felaket kurtarma (DR) stratejileri yönetiyorum.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-500 shadow-md shadow-emerald-500/20 hover:shadow-lg hover:shadow-emerald-500/30 transition-all duration-200"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          Teknik Makaleleri İncele
        </a>

        <a
          href="/about"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-sm font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-dark-card border border-slate-200 dark:border-dark-cardBorder hover:border-slate-300 dark:hover:border-slate-700 hover:bg-slate-50 dark:hover:bg-dark-hover shadow-sm transition-all duration-200"
        >
          Kariyer & Özgeçmiş
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

    </div>
  </section>

  <!-- Metrics / DBA Stats Banner -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-16 sm:mb-20">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 p-6 rounded-2xl bg-white/70 dark:bg-dark-card/70 border border-slate-200/80 dark:border-dark-cardBorder backdrop-blur-sm shadow-sm">
      <div class="space-y-1 text-center md:text-left">
        <div class="text-2xl sm:text-3xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400">99.999%</div>
        <div class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-medium">Hedeflenen SLA & HA</div>
      </div>
      <div class="space-y-1 text-center md:text-left">
        <div class="text-2xl sm:text-3xl font-extrabold font-mono text-cyan-600 dark:text-cyan-400">RPO ~ 0</div>
        <div class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-medium">Sıfır Veri Kaybı İlkesi</div>
      </div>
      <div class="space-y-1 text-center md:text-left">
        <div class="text-2xl sm:text-3xl font-extrabold font-mono text-emerald-600 dark:text-emerald-400">10+ TB</div>
        <div class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-medium">Yönetilen Aktif Veri</div>
      </div>
      <div class="space-y-1 text-center md:text-left">
        <div class="text-2xl sm:text-3xl font-extrabold font-mono text-cyan-600 dark:text-cyan-400">&lt; 50ms</div>
        <div class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-medium">P99 Sorgu Gecikmesi</div>
      </div>
    </div>
  </section>

  <!-- Core Competencies / Tech Stack -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
    <div class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
            Uzmanlık Alanları & Teknolojiler
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">
            Üretim ortamlarında yönettiğim temel veritabanı motorları, sistem araçları ve metodolojiler.
          </p>
        </div>
      </div>

      <div class="flex flex-wrap gap-2.5">
        {dbaCompetencies.map((tech) => (
          <TechBadge
            name={tech.name}
            category={tech.category as any}
            level={tech.level}
            size="md"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Featured / Recent Articles -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
    <div class="space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <div class="text-xs font-mono font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-1">
            Teknik Blog
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
            Son Yayınlanan Makaleler
          </h2>
        </div>
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-600 dark:text-emerald-400 hover:text-emerald-500 transition-colors"
        >
          Tüm Makaleleri Gör ({allPosts.length})
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {recentPosts.map((post) => (
          <ArticleCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <!-- Quick Contact Teaser -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
    <div class="p-8 sm:p-10 rounded-2xl bg-gradient-to-br from-slate-900 to-slate-950 text-white border border-slate-800 shadow-xl relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="max-w-xl space-y-4">
        <div class="text-xs font-mono uppercase tracking-wider text-emerald-400 font-bold">
          Birlikte Çalışalım
        </div>
        <h3 class="text-2xl sm:text-3xl font-bold tracking-tight">
          Veritabanı altyapınızda performans ve güvenilirlik desteğine mi ihtiyacınız var?
        </h3>
        <p class="text-slate-300 text-sm leading-relaxed">
          Veritabanı migrasyonları, performans analizi, High Availability küme kurulumları veya felaket kurtarma danışmanlığı için dilediğiniz zaman iletişime geçebilirsiniz.
        </p>
        <div class="pt-2">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold bg-emerald-500 hover:bg-emerald-400 text-slate-950 transition-colors"
          >
            İletişim Kur
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
