---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechBadge from '../components/TechBadge.astro';

const philosophies = [
  {
    title: 'Önce Veri Bütünlüğü (ACID First)',
    desc: 'Hiçbir hız kazanımı, bozulmuş veya kaybolmuş bir veriyi telafi edemez. Her mimari kararda ilk soru: "Veri tutarlılığı garanti altında mı?" olmalıdır.',
    icon: 'shield',
  },
  {
    title: 'Otomatize Et ya da Pişman Ol',
    desc: 'Manuel yapılan her veritabanı operasyonu insan hatasına açıktır. Yedekleme, failover, archiving ve sağlık kontrolleri kodla yönetilmeli ve sürekli test edilmelidir.',
    icon: 'cpu',
  },
  {
    title: 'Sıfır Kesinti (Zero-Downtime) Kültürü',
    desc: 'Canlı veritabanında lock oluşturan DDL işlemlerinden, büyük ölçekli sürüm yükseltmelerine (major upgrade) kadar her adım sıfır kesintiyle planlanmalıdır.',
    icon: 'clock',
  },
  {
    title: 'Kanıta Dayalı Optimizasyon (Metrics Driven)',
    desc: 'Tahminlerle veya kulaktan dolma indekslerle veritabanı hızlandırılamaz. EXPLAIN ANALYZE, pg_stat_statements, buffer okumaları ve I/O metrikleri yol göstericimizdir.',
