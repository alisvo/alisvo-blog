---
import BaseLayout from '../layouts/BaseLayout.astro';

const contactMethods = [
  {
    title: 'E-posta',
    description: 'Doğrudan e-posta gönderin. En hızlı iletişim kanalıdır.',
    value: 'ali.svo@hotmail.com.tr',
    href: 'mailto:ali.svo@hotmail.com.tr?subject=Mesleki%20Iletisim%20/%20alisvo.dev',
    actionText: 'E-posta Gönder',
    icon: 'mail',
    primary: true,
  },
  {
    title: 'LinkedIn',
    description: 'Profesyonel ağ ve kariyer bağlantıları.',
    value: 'linkedin.com/in/alisvo',
    href: 'https://www.linkedin.com/in/alisvo',
    actionText: 'Profile Git',
    icon: 'linkedin',
    primary: false,
  },
  {
    title: 'GitHub',
    description: 'Açık kaynak projeler, konfigürasyon şablonları ve scriptler.',
    value: 'github.com/alisvo',
    href: 'https://github.com/alisvo',
    actionText: 'GitHub Repoları',
    icon: 'github',
    primary: false,
  },
];
---

<BaseLayout
  title="İletişim | Ali Sağırvelioğulları"
  description="Ali Sağırvelioğulları ile iletişime geçin. Veritabanı sistemleri, teknik makaleler ve mesleki ağ bağlantıları."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    
    <!-- Page Header -->
    <header class="mb-12 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
        <span>Bağlantı Kur</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        İletişim
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl">
        Veritabanı mimarileri, optimizasyon, teknik makaleler veya mesleki ağ/iletişim talepleriniz için bana dilediğiniz zaman ulaşabilirsiniz.
      </p>
    </header>

    <!-- Main Contact Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      {contactMethods.map((item) => (
        <div class={`p-6 rounded-2xl flex flex-col justify-between transition-all duration-200 ${
          item.primary
            ? 'bg-gradient-to-b from-emerald-500/10 to-transparent dark:from-emerald-950/40 dark:to-dark-card border-2 border-emerald-500/40 shadow-lg shadow-emerald-500/5'
            : 'bg-white dark:bg-dark-card border border-slate-200/80 dark:border-dark-cardBorder shadow-sm hover:border-slate-300 dark:hover:border-slate-700'
        }`}>
          <div>
            <div class="flex items-center justify-between mb-4">
              <span lang="en" class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                {item.title}
              </span>
              {item.primary && (
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300">
                  Önerilen
                </span>
              )}
            </div>

            <h3 class="text-lg font-bold text-slate-900 dark:text-white font-mono break-all mb-2">
              {item.value}
            </h3>

            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
              {item.description}
            </p>
          </div>

          <a
            href={item.href}
            target={item.primary ? '_self' : '_blank'}
            rel={item.primary ? '' : 'noopener noreferrer'}
            class={`inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl text-xs font-semibold transition-all ${
              item.primary
                ? 'bg-emerald-600 hover:bg-emerald-500 text-white shadow-sm'
                : 'bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700'
            }`}
          >
            {item.actionText}
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      ))}
    </div>

    <!-- Quick Info / Professional Network & Contact Notes Card -->
    <div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-dark-card border border-slate-200/80 dark:border-dark-cardBorder space-y-4 shadow-sm">
      <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <svg class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Mesleki Ağ & İletişim Notları
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-slate-600 dark:text-slate-300">
        <div class="space-y-1">
          <div class="font-semibold text-slate-900 dark:text-slate-100">Geri Dönüş Süresi</div>
          <p class="text-xs text-slate-600 dark:text-slate-400">Gelen e-posta ve LinkedIn mesajlarına genellikle 24-48 saat içerisinde dönüş yapıyorum.</p>
        </div>
        <div class="space-y-1">
          <div class="font-semibold text-slate-900 dark:text-slate-100">İletişim Odakları</div>
          <p class="text-xs text-slate-600 dark:text-slate-400">Veritabanı teknolojileri, sektör deneyimleri, teknik makaleler ve profesyonel ağ bağlantıları.</p>
        </div>
      </div>
    </div>

  </div>
</BaseLayout>
