---
interface Props {
  name: string;
  category?: 'database' | 'skill' | 'os' | 'tool';
  level?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { name, level, size = 'md' } = Astro.props;

// SVG icons or badges based on name
const isPostgres = name.toLowerCase().includes('postgres');
const isOracle = name.toLowerCase().includes('oracle');
const isMSSQL = name.toLowerCase().includes('mssql') || name.toLowerCase().includes('sql server');
const isMySQL = name.toLowerCase().includes('mysql');
const isLinux = name.toLowerCase().includes('linux');
const isRedis = name.toLowerCase().includes('redis');
const isHA = name.toLowerCase().includes('availability') || name.toLowerCase().includes('ha');
const isTuning = name.toLowerCase().includes('tuning') || name.toLowerCase().includes('performans');
const isBackup = name.toLowerCase().includes('backup') || name.toLowerCase().includes('dr') || name.toLowerCase().includes('kurtarma') || name.toLowerCase().includes('pitr');
const isAWS = name.toLowerCase().includes('aws') || name.toLowerCase().includes('amazon');
const isAzure = name.toLowerCase().includes('azure');
const isPython = name.toLowerCase().includes('python');
---

<div class={`group inline-flex items-center gap-2 rounded-lg font-medium transition-all duration-200 
  ${size === 'sm' ? 'px-2.5 py-1 text-xs' : size === 'lg' ? 'px-4 py-2.5 text-base' : 'px-3 py-1.5 text-sm'}
  bg-white dark:bg-dark-card border border-slate-200/90 dark:border-dark-cardBorder 
  text-slate-800 dark:text-slate-200 
  shadow-sm hover:shadow hover:border-emerald-500/60 dark:hover:border-emerald-500/60 
  hover:-translate-y-0.5`}>
  
  <!-- Icon container -->
  <span class="flex-shrink-0 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
    {isPostgres && (
      <svg class="w-4 h-4" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 16.93V15h-2v3.93C7.05 18.44 4 15.58 4 12c0-4.41 3.59-8 8-8s8 3.59 8 8c0 3.58-3.05 6.44-7 6.93zM11 9h2v4h-2zm0-4h2v2h-2z" />
      </svg>
    )}
    {isOracle && (
      <svg class="w-4 h-4 text-red-500 dark:text-red-400" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 4C5.5 4 2 7.5 2 12s3.5 8 10 8 10-3.5 10-8-3.5-8-10-8zm0 13c-4.5 0-6.5-2.2-6.5-5s2-5 6.5-5 6.5 2.2 6.5 5-2 5-6.5 5z"/>
      </svg>
    )}
    {isMSSQL && (
      <svg class="w-4 h-4 text-sky-600 dark:text-sky-400" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M4 4h7v7H4V4zm9 0h7v7h-7V4zm-9 9h7v7H4v-7zm9 0h7v7h-7v-7z"/>
      </svg>
    )}
    {isMySQL && (
      <svg class="w-4 h-4 text-amber-500 dark:text-amber-400" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2a10 10 0 100 20 10 10 0 000-20zm1 14.5c-3.1 0-5.5-1.8-5.5-4s2.4-4 5.5-4 5.5 1.8 5.5 4-2.4 4-5.5 4z"/>
      </svg>
    )}
    {isLinux && (
      <svg class="w-4 h-4 text-yellow-600 dark:text-yellow-400" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C9.5 2 7.5 4 7.5 6.5c0 1.2.5 2.3 1.3 3.1-.3 1.1-.8 2.8-.8 4.4 0 2.5 1.5 5 4 5s4-2.5 4-5c0-1.6-.5-3.3-.8-4.4.8-.8 1.3-1.9 1.3-3.1C16.5 4 14.5 2 12 2zm-2 5a1 1 0 110-2 1 1 0 010 2zm4 0a1 1 0 110-2 1 1 0 010 2z"/>
      </svg>
    )}
    {isRedis && (
      <svg class="w-4 h-4 text-rose-500" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2L2 7l10 5 10-5-10-5zm0 9l-8-4v6l8 4 8-4v-6l-8 4z"/>
      </svg>
    )}
    {isTuning && (
      <svg class="w-4 h-4 text-emerald-500" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
    )}
    {isHA && (
      <svg class="w-4 h-4 text-cyan-500" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
    )}
    {isBackup && (
      <svg class="w-4 h-4 text-indigo-500 dark:text-indigo-400" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
      </svg>
    )}
    {isAzure && isAWS && (
      <span class="inline-flex items-center gap-1.5 flex-shrink-0">
        <svg class="w-3.5 h-3.5 flex-shrink-0" width="14" height="14" viewBox="0 0 24 24">
          <path fill="#0089D6" d="M13.05 4.24l-5.6 9.87 3.52 6.13H1.73L0 17.15l6.32-11.1 4.38-1.81 2.35 0zm.8 1.41L7.53 16.7h4.86l4.63-8.08-3.17-2.97z"/>
          <path fill="#005BA1" d="M24 18.76L18.47 9.15 15.3 14.7l4.13 4.06H24z"/>
        </svg>
        <svg class="w-3.5 h-3.5 flex-shrink-0 text-amber-500 dark:text-amber-400" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.77 15.65c-2.31 1.7-5.55 2.6-8.43 2.6-4.04 0-7.69-1.5-10.45-4.01-.22-.2-.04-.47.22-.32 2.98 1.73 6.64 2.77 10.45 2.77 2.56 0 5.43-.65 7.97-2.02.39-.21.68.23.24.98zM19.92 14.15c-.29-.37-1.92-.18-2.65-.09-.22.03-.26-.14-.06-.28 1.32-.93 3.49-.66 3.74-.35.25.32-.07 2.48-1.32 3.5-.19.16-.38.07-.3-.14.28-.73.88-2.27.59-2.64z"/>
        </svg>
      </span>
    )}
    {isAzure && !isAWS && (
      <svg class="w-4 h-4 flex-shrink-0" width="16" height="16" viewBox="0 0 24 24">
        <path fill="#0089D6" d="M13.05 4.24l-5.6 9.87 3.52 6.13H1.73L0 17.15l6.32-11.1 4.38-1.81 2.35 0zm.8 1.41L7.53 16.7h4.86l4.63-8.08-3.17-2.97z"/>
        <path fill="#005BA1" d="M24 18.76L18.47 9.15 15.3 14.7l4.13 4.06H24z"/>
      </svg>
    )}
    {isAWS && !isAzure && (
      <svg class="w-4 h-4 text-amber-500 dark:text-amber-400" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M18.77 15.65c-2.31 1.7-5.55 2.6-8.43 2.6-4.04 0-7.69-1.5-10.45-4.01-.22-.2-.04-.47.22-.32 2.98 1.73 6.64 2.77 10.45 2.77 2.56 0 5.43-.65 7.97-2.02.39-.21.68.23.24.98zM19.92 14.15c-.29-.37-1.92-.18-2.65-.09-.22.03-.26-.14-.06-.28 1.32-.93 3.49-.66 3.74-.35.25.32-.07 2.48-1.32 3.5-.19.16-.38.07-.3-.14.28-.73.88-2.27.59-2.64z"/>
      </svg>
    )}
    {isPython && (
      <svg class="w-4 h-4 text-sky-500 dark:text-sky-400" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M11.91 2c-5.07 0-4.75 2.2-4.75 2.2l.01 2.28h4.82v.69H5.16S2 6.8 2 11.89c0 5.08 2.76 4.9 2.76 4.9h1.64v-2.31c0-2.61 2.23-2.52 2.23-2.52h4.74c2.16 0 2.14-2.08 2.14-2.08V5.07s.4-3.07-3.66-3.07zm-2.6 1.53c.53 0 .96.43.96.96 0 .52-.43.95-.96.95-.52 0-.95-.43-.95-.95 0-.53.43-.96.95-.96zm2.78 18.47c5.07 0 4.75-2.2 4.75-2.2l-.01-2.28h-4.82v-.69h6.83s3.16.37 3.16-4.72c0-5.08-2.76-4.9-2.76-4.9h-1.64v2.31c0 2.61-2.23 2.52-2.23 2.52h-4.74c-2.16 0-2.14 2.08-2.14 2.08v4.81s-.4 3.07 3.66 3.07zm2.6-1.53c-.53 0-.96-.43-.96-.96 0-.52.43-.95.96-.95.52 0 .95.43.95.95 0 .53-.43.96-.95.96z"/>
      </svg>
    )}
    {!isPostgres && !isOracle && !isMSSQL && !isMySQL && !isLinux && !isRedis && !isTuning && !isHA && !isBackup && !isAWS && !isAzure && !isPython && (
      <svg class="w-4 h-4 text-emerald-500" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
      </svg>
    )}
  </span>

  <span class="tracking-tight">{name}</span>

  {level && (
    <span lang="en" class="text-[11px] uppercase tracking-wider font-mono text-slate-600 dark:text-slate-300 ml-0.5 bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">
      {level}
    </span>
  )}
</div>
