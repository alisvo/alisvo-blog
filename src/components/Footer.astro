---
// Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-200/80 dark:border-slate-800/80 bg-slate-50/50 dark:bg-dark-bg/60 transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Status Badge & Branding -->
      <div class="flex flex-col sm:flex-row items-center gap-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-400">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>Tüm Sistemler Aktif • 99.999% SLA</span>
        </div>
        <span class="hidden sm:inline text-slate-300 dark:text-slate-700">|</span>
        <p class="text-xs text-slate-600 dark:text-slate-400">
          © {currentYear} Ali Sağırvelioğulları. Tüm hakları saklıdır.
        </p>
      </div>

      <!-- Social & Utility Links -->
      <div class="flex items-center gap-4 text-slate-600 dark:text-slate-400">
        <!-- GitHub -->
        <a
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 hover:text-slate-900 dark:hover:text-white rounded-lg hover:bg-slate-200/60 dark:hover:bg-slate-800 transition-colors"
          aria-label="GitHub Profilim"
          title="GitHub"
        >
          <svg class="w-4 h-4" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://linkedin.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 hover:text-[#0A66C2] dark:hover:text-[#0A66C2] rounded-lg hover:bg-slate-200/60 dark:hover:bg-slate-800 transition-colors"
          aria-label="LinkedIn Profilim"
          title="LinkedIn"
        >
          <svg class="w-4 h-4" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28z"/>
          </svg>
        </a>

        <!-- Email -->
        <a
          href="mailto:ali.svo@hotmail.com.tr"
          class="p-2 hover:text-emerald-600 dark:hover:text-emerald-400 rounded-lg hover:bg-slate-200/60 dark:hover:bg-slate-800 transition-colors"
          aria-label="E-posta Gönder"
          title="E-posta: ali.svo@hotmail.com.tr"
        >
          <svg class="w-4 h-4" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>

        <!-- RSS -->
        <a
          href="/rss.xml"
          class="p-2 hover:text-amber-600 dark:hover:text-amber-400 rounded-lg hover:bg-slate-200/60 dark:hover:bg-slate-800 transition-colors"
          aria-label="RSS Beslemesi"
          title="Teknik Blog RSS Feed"
        >
          <svg class="w-4 h-4" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
            <circle cx="6.18" cy="17.82" r="2.18" />
            <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</footer>
